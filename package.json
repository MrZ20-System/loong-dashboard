{
  "name": "loongboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <27.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --if-present --filter @loongboard/web --filter @loongboard/server dev",
    "build": "pnpm --recursive run build",
    "start": "node --conditions=production apps/server/dist/start.js",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm test:ut",
    "test:ut": "node scripts/run-workspace-tests.mjs",
    "test:regression": "vitest run tests/regression --config vitest.config.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:dsh-boundary": "node scripts/check-architecture.mjs --rule dsh-import,dsh-manifest",
    "check:dsh-pin": "node scripts/check-dsh-pin.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm check:architecture && pnpm check:dsh-pin && pnpm test:ut && pnpm build",
    "check:full": "pnpm check && pnpm test:regression"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.42.0",
    "@types/node": "24.3.0",
    "eslint": "9.35.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
